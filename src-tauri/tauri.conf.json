{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dojo",
  "version": "1.1.0",
  "identifier": "com.onmyway133.DevTools",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dojo",
        "width": 1200,
        "height": 780,
        "minWidth": 820,
        "minHeight": 520,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 18,
          "y": 37
        },
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENEMzdDNzEyRUE1M0I1MzQKUldRMHRWUHFFc2MzemE4SGZaNzAyM2FCUWFNVnJIUGZQUnN6bHR3S1ZPRDhTSXlseDRWV0R0QjEK",
      "endpoints": [
        "https://github.com/indiegoodies/Dojo/releases/latest/download/latest.json"
      ]
    }
  }
}
