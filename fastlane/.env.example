# Copy to fastlane/.env (gitignored) and fill in. fastlane loads it automatically.
DEVELOPER_ID_IDENTITY="Developer ID Application: Your Name (TEAMID)"
NOTARY_KEYCHAIN_PROFILE=your-notarytool-profile
# Analytics for release builds. Builds without these (like `pnpm tauri dev`) send nothing.
SUMFLARE_APP_KEY=
SUMFLARE_ENDPOINT=
# Optional, defaults to ~/.tauri/devtools.key
# TAURI_UPDATER_KEY_PATH=~/.tauri/devtools.key
